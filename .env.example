# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=architect
POSTGRES_PASSWORD=architect
POSTGRES_DB=architect
POSTGRES_PORT=5432
DATABASE_URL=postgres://architect:architect@localhost:5432/architect?sslmode=disable

# --- Ollama (natywny, na hoście) ---
# Model jest już pociągnięty w systemie: `ollama list` -> qwen2.5-coder:14b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
