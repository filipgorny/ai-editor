# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=architect
POSTGRES_PASSWORD=architect
POSTGRES_DB=architect
POSTGRES_PORT=5432
DATABASE_URL=postgres://architect:architect@localhost:5432/architect?sslmode=disable

# --- Ollama (natywny, na hoście) ---
# Serwis ai woła Ollamę z kontenera przez host.docker.internal (patrz docker-compose.yml).
# Model jest już pociągnięty w systemie: `ollama list` -> qwen2.5-coder:14b
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# --- OpenAI (opcjonalnie; ustawienie przełącza serwis ai na providera openai) ---
# OPENAI_API_KEY=

# --- Porty serwisów na hoście (opcjonalne nadpisania; domyślne = 500xx/63xx) ---
# Electron gada tylko z gatewayem (GATEWAY_PORT). Reszta wystawiona dla debugowania.
# GATEWAY_PORT=50061
# SCANNER_PORT=50051
# AI_PORT=50071
# DESIGNER_PORT=50081
# EVENTS_PORT=50091
# FILER_PORT=50101
# SCRIPTING_PORT=50111
# LOGS_PORT=50121
# REDIS_PORT=6379

# --- logs: osobna baza (opcjonalnie; domyślnie współdzielony Postgres) ---
# LOGS_DATABASE_URL=
